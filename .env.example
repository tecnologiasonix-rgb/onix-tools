# ============================================================
# VARIABLES PÚBLICAS (para el navegador) — Firebase Auth (cliente)
# ============================================================
# Se obtienen en: Firebase Console > Configuración del proyecto >
# General > "Tus apps" > (crea una app Web si no tienes) > Config del SDK
#
# Estas NO son secretas: identifican tu proyecto de Firebase, no dan
# acceso a nada por sí solas (por eso llevan el prefijo NEXT_PUBLIC_).

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ============================================================
# VARIABLES PRIVADAS (solo servidor) — Firebase Admin SDK
# ============================================================
# Se obtienen en: Firebase Console > Configuración del proyecto >
# Cuentas de servicio > "Generar nueva clave privada" (descarga un JSON)
#
# ¡¡NUNCA subas estas variables a GitHub ni las pongas como NEXT_PUBLIC_!!
# Solo van en .env.local (que está en .gitignore) y en las variables de
# entorno de Vercel (marcadas como "Production/Preview/Development").

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Pega la private_key completa del JSON, incluyendo -----BEGIN/END-----.
# Si la pegas en una sola línea, sustituye los saltos de línea reales por \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXX\n-----END PRIVATE KEY-----\n"

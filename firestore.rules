rules_version = '2';

// Toda la lectura/escritura de "assignments" pasa por las API routes de
// Next.js (servidor), que usan el Admin SDK y por tanto se saltan estas
// reglas. Desde el navegador NO se debe acceder a Firestore directamente,
// así que bloqueamos todo acceso de cliente para máxima seguridad.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
